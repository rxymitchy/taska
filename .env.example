# Copy this file to .env before the first run. Do not commit .env.

# Local database from `npm run db` (PGlite on 127.0.0.1:5432).
# pgbouncer=true and connection_limit=1 are required with that server.
# Without them Prisma retries a prepared statement and Postgres returns 42P05.
#
# Docker Compose uses a different URL. Do not run both on port 5432.
# postgresql://taska:taska@localhost:5432/taska?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public&pgbouncer=true&connection_limit=1

# Signs the login session. Generate a new value before sharing a deployment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Public URL Auth.js uses for callbacks. Change this if the app is not on port 3000.
# Public URL Auth.js uses for callbacks. Localhost for `npm run dev`.
# Production must be the live site, e.g. https://taska-beta.vercel.app
AUTH_URL=http://localhost:3000

# Confirmation email after signup. Signup still works if these are empty.
# https://resend.com — EMAIL_FROM must be a sender Resend will accept.
# RESEND_API_KEY=
# EMAIL_FROM=Taska <noreply@yourdomain.com>

# Lightning: mock locally. Live uses Breez SDK Spark when both secrets below are set.
# Request an API key: https://breez.technology/contact/apikey
# Paste the key as one line (no BEGIN CERTIFICATE wrappers).
# Keep the 12 or 24 words offline. Never commit them.
# BREEZ_API_KEY=
# BREEZ_MNEMONIC=
# BREEZ_NETWORK=mainnet
# Optional. Only if you want Breez to store state in Postgres instead of /tmp.
# BREEZ_DATABASE_URL=
EVALUATOR_PAYOUT_SATS=500
REVIEWER_PAYOUT_SATS=400
# 200 = 2%. Company is charged evaluator + reviewer + this fee, rounded up (918 sats at 500 + 400).
PLATFORM_FEE_BPS=200
# Optional live Lightning address if the reviewer has none saved. Do not use a @taska.demo placeholder.
# REVIEWER_LIGHTNING_ADDRESS=

# Optional OpenAI API. Keep the key server-side; never use a NEXT_PUBLIC_ variable.
# Answer generation falls back to a local demo reply without a key; AI pre-checks are marked unavailable.
 #AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_EVALUATION_MODEL=gpt-4o-mini

# Approximate USD shown next to sat amounts. Display only. The app does not convert funds.
BTC_USD_PRICE=65000
NEXT_PUBLIC_BTC_USD_PRICE=65000

# Optional. These emails can open the review queue even if they are not ADMIN.
# FOUNDING_REVIEWER_EMAILS=you@example.com

# Shows the demo account buttons on /login. Set this to false before a public deployment.
DEMO_LOGIN=true
# Password hashed into the accounts created by `npm run db:seed`.
DEMO_PASSWORD=demo1234

# Balance returned by MockLightningProvider. Not a wallet and not stored as user funds.
MOCK_LIGHTNING_BALANCE_SATS=2000000
