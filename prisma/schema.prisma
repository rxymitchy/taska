// Postgres through DATABASE_URL.
// Locally: start `npm run db` (or Docker Compose), then `npx prisma migrate deploy`.
// `npm install` runs `prisma generate`, which rebuilds the client from this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  EMPLOYER
  ADMIN
}

enum TaskStatus {
  FUNDED
  CLOSED
}

enum TaskType {
  AI_RESPONSE_EVALUATION
  GENERIC
}

enum ItemStatus {
  AVAILABLE
  ASSIGNED
  SUBMITTED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SENT
  FAILED
}

enum LightningStatus {
  PENDING
  PAID
  FAILED
}

// Company → evaluator → reviewer. Teammate modules must not invent a second status list.
enum EvaluationStatus {
  PENDING
  ASSIGNED
  WORKER_COMPLETED
  UNDER_REVIEW
  APPROVED
  COMPLETED
  REJECTED
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
}

enum CreditKind {
  DEPOSIT
  HOLD
  RELEASE
  SPEND
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  role              Role
  lightningAddress  String?
  createdAt         DateTime         @default(now())
  workerProfile     WorkerProfile?
  employerProfile   EmployerProfile?
  passwordResets    PasswordReset[]
}

model WorkerProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  country          String
  bio              String           @default("")
  skills           String[]
  languages        String[]
  cvFileName       String?
  githubUrl        String?
  portfolioUrl     String?
  lightningAddress String?
  tasksCompleted   Int              @default(0)
  approvalRate     Float            @default(0)
  qualityScore     Float            @default(0)
  createdAt        DateTime         @default(now())
  submissions            TaskSubmission[]
  payments               Payment[]
  assignments            TaskItem[]
  assignedEvaluations    Evaluation[]             @relation("AssignedEvaluator")
  evaluationSubmissions  EvaluationSubmission[]
}

model EmployerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  companyDescription String   @default("")
  prepaidSats        Int      @default(0)
  heldSats           Int      @default(0)
  createdAt          DateTime @default(now())
  tasks              Task[]
  evaluations        Evaluation[]
  batches            EvaluationBatch[]
  creditLedger       CreditLedger[]
  creditDeposits     CreditDeposit[]
}

model Task {
  id                String           @id @default(cuid())
  employerId        String
  employer          EmployerProfile  @relation(fields: [employerId], references: [id])
  title             String
  description       String
  category          String
  instructions      String
  rewardSats        Int
  quantity          Int
  completedQuantity Int              @default(0)
  language          String
  requiredSkills    String[]
  estimatedMinutes  Int
  status            TaskStatus       @default(FUNDED)
  taskType          TaskType         @default(GENERIC)
  autoApprove       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  items             TaskItem[]
  submissions       TaskSubmission[]

  @@index([status, category])
}

model TaskItem {
  id               String           @id @default(cuid())
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  prompt           String
  responseA        String
  responseB        String
  referenceChoice  String?
  status           ItemStatus       @default(AVAILABLE)
  assignedWorkerId String?
  assignedWorker   WorkerProfile?   @relation(fields: [assignedWorkerId], references: [id])
  assignedAt       DateTime?
  submission       TaskSubmission?

  @@index([taskId, status])
}

model TaskSubmission {
  id           String            @id @default(cuid())
  taskId       String
  task         Task              @relation(fields: [taskId], references: [id])
  taskItemId   String?           @unique
  taskItem     TaskItem?         @relation(fields: [taskItemId], references: [id])
  workerId     String
  worker       WorkerProfile     @relation(fields: [workerId], references: [id])
  answers      Json
  status       SubmissionStatus  @default(PENDING)
  qualityScore Int?
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  payment      Payment?

  @@index([workerId, submittedAt])
  @@index([status])
}

model Payment {
  id               String            @id @default(cuid())
  workerId         String
  worker           WorkerProfile     @relation(fields: [workerId], references: [id])
  submissionId     String            @unique
  submission       TaskSubmission    @relation(fields: [submissionId], references: [id])
  amountSats       Int
  paymentMethod    String            @default("LIGHTNING")
  paymentReference String?
  status           PaymentStatus     @default(PENDING)
  createdAt        DateTime          @default(now())
  lightningPayment LightningPayment?

  @@index([workerId, createdAt])
}

model LightningPayment {
  id          String          @id @default(cuid())
  paymentId   String          @unique
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     String
  paymentHash String
  destination String
  amountSats  Int
  status      LightningStatus
  createdAt   DateTime        @default(now())
}

// One AI response submitted by a company for human evaluation.
// Assignment, extra evaluators, model calls, and real Lightning stay outside this row.
model EvaluationBatch {
  id          String           @id @default(cuid())
  companyId   String
  company     EmployerProfile  @relation(fields: [companyId], references: [id])
  fileName    String
  rowCount    Int
  createdAt   DateTime         @default(now())
  evaluations Evaluation[]

  @@index([companyId, createdAt])
}

model Evaluation {
  id               String             @id @default(cuid())
  companyId        String
  company          EmployerProfile    @relation(fields: [companyId], references: [id])
  batchId          String?
  batch            EvaluationBatch?   @relation(fields: [batchId], references: [id])
  prompt           String
  aiResponse       String
  aiModel          String           @default("pasted")
  language         String
  context          String
  status           EvaluationStatus   @default(PENDING)
  heldSats         Int                @default(0)
  assignedWorkerId String?
  assignedWorker   WorkerProfile?     @relation("AssignedEvaluator", fields: [assignedWorkerId], references: [id])
  assignedAt       DateTime?
  createdAt        DateTime           @default(now())
  completedAt      DateTime?
  submissions      EvaluationSubmission[]
  payouts          EvaluationPayout[]
  creditEvents     CreditLedger[]

  @@index([companyId, createdAt])
  @@index([status])
  @@index([assignedWorkerId])
  @@index([batchId])
}

model CreditLedger {
  id           String          @id @default(cuid())
  companyId    String
  company      EmployerProfile @relation(fields: [companyId], references: [id])
  kind         CreditKind
  amountSats   Int
  evaluationId String?
  evaluation   Evaluation?     @relation(fields: [evaluationId], references: [id])
  depositId    String?
  deposit      CreditDeposit?  @relation(fields: [depositId], references: [id])
  note         String          @default("")
  createdAt    DateTime        @default(now())

  @@index([companyId, createdAt])
}

model CreditDeposit {
  id          String           @id @default(cuid())
  companyId   String
  company     EmployerProfile  @relation(fields: [companyId], references: [id])
  amountSats  Int
  invoice     String
  paymentHash String           @unique
  checkoutUrl String           @default("")
  status      LightningStatus  @default(PENDING)
  createdAt   DateTime         @default(now())
  paidAt      DateTime?
  ledger      CreditLedger[]

  @@index([companyId, createdAt])
}

model ReviewerInvite {
  id              String    @id @default(cuid())
  email           String
  tokenHash       String    @unique
  invitedByUserId String
  usedAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EvaluationSubmission {
  id                  String        @id @default(cuid())
  evaluationId        String
  evaluation          Evaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  workerId            String
  worker              WorkerProfile @relation(fields: [workerId], references: [id])
  factuallyCorrect    Boolean
  languageNatural     Boolean
  understandsContext  Boolean
  // Required by the form whenever any of the three answers is No.
  betterAnswer        String        @default("")
  comment             String        @default("")
  submittedAt         DateTime      @default(now())
  reviewedAt          DateTime?
  reviewerUserId      String?

  @@index([evaluationId, submittedAt])
  @@index([workerId])
}

// Lightning payout for an approved evaluation. Taska does not hold user funds.
model EvaluationPayout {
  id           String       @id @default(cuid())
  evaluationId String
  evaluation   Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  payeeRole    Role
  payeeUserId  String
  rail         String       @default("LIGHTNING")
  amountSats   Int          @default(0)
  destination  String       @default("")
  invoice      String       @default("")
  paymentHash  String       @default("")
  status       PayoutStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  settledAt    DateTime?

  @@unique([evaluationId, payeeRole])
  @@index([payeeUserId])
}
